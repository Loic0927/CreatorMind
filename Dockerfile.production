FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY alembic.ini alembic.ini
COPY scripts/oci scripts/oci

RUN groupadd --system --gid 10001 creatormind \
    && useradd --system --uid 10001 --gid creatormind --home-dir /app creatormind \
    && chmod +x scripts/oci/*.sh \
    && chown -R creatormind:creatormind /app

USER creatormind
EXPOSE 8000
ENTRYPOINT ["/app/scripts/oci/entrypoint.sh"]
