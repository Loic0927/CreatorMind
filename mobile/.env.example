# Public, non-secret client configuration only.
# Physical phone: use your Windows PC's LAN IPv4 address, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_API_ENV=local-lan
# Use api for real server-side Gemini captions; mock remains available for offline UI testing.
EXPO_PUBLIC_CAPTION_MODE=api

# Android emulator alternative: http://10.0.2.2:8000
# iOS simulator alternative: http://127.0.0.1:8000
# Production alternative after domain purchase: https://api.postbridge.dev
