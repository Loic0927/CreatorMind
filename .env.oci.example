# Copy to .env.oci; placeholders only. Never commit the resulting file.
POSTBRIDGE_WEB_DOMAIN=postbridge.dev
POSTBRIDGE_WWW_DOMAIN=www.postbridge.dev
POSTBRIDGE_API_DOMAIN=api.postbridge.dev
POSTBRIDGE_PUBLIC_API_URL=https://api.postbridge.dev
POSTBRIDGE_ENV=production
POSTBRIDGE_ALLOWED_HOSTS=api.postbridge.dev
POSTBRIDGE_CORS_ALLOWED_ORIGINS=https://postbridge.dev
POSTBRIDGE_MAX_UPLOAD_BYTES=10485760
NGINX_CLIENT_MAX_BODY_SIZE=10m

POSTGRES_DB=creatormind
POSTGRES_USER=creatormind
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTBRIDGE_DATABASE_URL=postgresql+psycopg://creatormind:replace-with-url-encoded-password@db:5432/creatormind
POSTBRIDGE_RUN_MIGRATIONS=true
POSTBRIDGE_GUNICORN_WORKERS=1
POSTBRIDGE_GUNICORN_TIMEOUT=120
POSTBRIDGE_TRACKING_POLL_SECONDS=3600
POSTBRIDGE_AUTH_SECRET=replace-with-long-random-auth-secret
POSTBRIDGE_LOGIN_CODE_COOLDOWN_SECONDS=60
POSTBRIDGE_SMTP_HOST=replace-with-smtp-host
POSTBRIDGE_SMTP_PORT=587
POSTBRIDGE_SMTP_USERNAME=replace-with-smtp-username
POSTBRIDGE_SMTP_PASSWORD=replace-with-smtp-password
POSTBRIDGE_SMTP_SSL=false
POSTBRIDGE_EMAIL_FROM="PostBridge <login@postbridge.dev>"

POSTBRIDGE_INSTAGRAM_CLIENT_ID=replace-with-meta-app-client-id
POSTBRIDGE_INSTAGRAM_CLIENT_SECRET=replace-with-meta-app-client-secret
POSTBRIDGE_INSTAGRAM_REDIRECT_URI=https://api.postbridge.dev/api/instagram/connect/callback
POSTBRIDGE_INSTAGRAM_APP_RETURN_URI=postbridge://instagram-connected
POSTBRIDGE_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
POSTBRIDGE_OAUTH_STATE_SECRET=replace-with-long-random-secret
POSTBRIDGE_INSTAGRAM_COMMENTS_ENABLED=false
POSTBRIDGE_INSTAGRAM_COMMENT_ACCOUNT_ALLOWLIST=
POSTBRIDGE_SCREENSHOT_TOKEN_SECRET=replace-with-long-random-secret
YOUTUBE_API_KEY=replace-with-youtube-api-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
YOUTUBE_OAUTH_REDIRECT_URI=https://api.postbridge.dev/auth/youtube/callback
FRONTEND_BASE_URL=https://postbridge.dev
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=replace-with-enabled-model-name
GEMINI_VISION_MODEL=replace-with-enabled-vision-model-name

POSTBRIDGE_MEDIA_STORAGE=oci
OCI_REGION=ap-sydney-1
OCI_NAMESPACE=replace-with-object-storage-namespace
OCI_BUCKET_NAME=replace-with-private-bucket-name
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_CONFIG_HOST_PATH=./secrets/oci_config
OCI_USER_OCID=replace-with-user-ocid
OCI_TENANCY_OCID=replace-with-tenancy-ocid
OCI_FINGERPRINT=replace-with-api-key-fingerprint
OCI_PRIVATE_KEY_PATH=/run/secrets/oci_api_key.pem
OCI_PRIVATE_KEY_HOST_PATH=./secrets/oci_api_key.pem
OCI_BACKUP_PREFIX=database-backups
BACKUP_RETENTION_DAYS=14

CERTBOT_EMAIL=admin@example.com
