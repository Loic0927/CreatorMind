upstream postbridge_api {
    server app:8000;
    keepalive 16;
}

upstream postbridge_web {
    server frontend:3000;
    keepalive 16;
}

server {
    listen 80;
    server_name ${NGINX_WEB_SERVER_NAME} ${NGINX_WWW_SERVER_NAME};

    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${NGINX_WEB_SERVER_NAME}$request_uri; }
}

server {
    listen 80;
    server_name ${NGINX_API_SERVER_NAME};

    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${NGINX_API_SERVER_NAME}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_WWW_SERVER_NAME};

    ssl_certificate /etc/letsencrypt/live/${NGINX_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://${NGINX_WEB_SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_WEB_SERVER_NAME};

    ssl_certificate /etc/letsencrypt/live/${NGINX_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location / {
        proxy_pass http://postbridge_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_API_SERVER_NAME};

    ssl_certificate /etc/letsencrypt/live/${NGINX_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location / {
        proxy_pass http://postbridge_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
