# Copy to .env.production in this directory; never commit the resulting file.
POSTBRIDGE_DOMAIN=api.example.com
POSTBRIDGE_ENV=production
POSTBRIDGE_ALLOWED_HOSTS=api.example.com
POSTBRIDGE_CORS_ALLOWED_ORIGINS=https://app.example.com
POSTBRIDGE_MAX_UPLOAD_BYTES=10485760

POSTBRIDGE_DATABASE_URL=postgresql+psycopg://postbridge:replace-with-url-encoded-password@db:5432/postbridge
POSTGRES_DB=postbridge
POSTGRES_USER=postbridge
POSTGRES_PASSWORD=replace-with-strong-random-password

POSTBRIDGE_INSTAGRAM_CLIENT_ID=replace-with-meta-app-client-id
POSTBRIDGE_INSTAGRAM_CLIENT_SECRET=replace-with-meta-app-client-secret
POSTBRIDGE_INSTAGRAM_REDIRECT_URI=https://api.example.com/api/instagram/connect/callback
POSTBRIDGE_INSTAGRAM_APP_RETURN_URI=creatormind://instagram-connected
POSTBRIDGE_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
POSTBRIDGE_OAUTH_STATE_SECRET=replace-with-long-random-secret

YOUTUBE_API_KEY=replace-with-youtube-api-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
YOUTUBE_OAUTH_REDIRECT_URI=https://api.example.com/auth/youtube/callback
FRONTEND_BASE_URL=https://app.example.com

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=replace-with-enabled-model-name
