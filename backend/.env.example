# Local backend runtime. Copy this file to backend/.env and replace placeholders.
# backend/.env is ignored by Git and is the only dotenv file loaded by FastAPI.
POSTBRIDGE_ENV=development
POSTBRIDGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTBRIDGE_MAX_UPLOAD_BYTES=10485760
POSTBRIDGE_AUTH_SECRET=generate-a-long-random-auth-secret
POSTBRIDGE_LOGIN_CODE_COOLDOWN_SECONDS=60
POSTBRIDGE_SMTP_HOST=
POSTBRIDGE_SMTP_PORT=587
POSTBRIDGE_SMTP_USERNAME=
POSTBRIDGE_SMTP_PASSWORD=
POSTBRIDGE_SMTP_SSL=false
POSTBRIDGE_EMAIL_FROM=PostBridge <login@your-domain.example>

# Instagram Login OAuth (server-side secrets only)
POSTBRIDGE_INSTAGRAM_CLIENT_ID=your-instagram-client-id
POSTBRIDGE_INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
POSTBRIDGE_INSTAGRAM_REDIRECT_URI=https://your-backend.example/api/instagram/connect/callback
POSTBRIDGE_INSTAGRAM_APP_RETURN_URI=postbridge://instagram-connected
POSTBRIDGE_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key
POSTBRIDGE_OAUTH_STATE_SECRET=generate-a-long-random-secret
POSTBRIDGE_INSTAGRAM_COMMENTS_ENABLED=false
POSTBRIDGE_SCREENSHOT_TOKEN_SECRET=generate-a-long-random-secret

# Optional locally. Leave blank to use the local JSON-backed development store.
POSTBRIDGE_DATABASE_URL=
# Automatic post-publish tracking requires PostgreSQL and the separate worker.
POSTBRIDGE_TRACKING_POLL_SECONDS=60
POSTBRIDGE_TRACKING_BATCH_SIZE=5

# YouTube API and OAuth
YOUTUBE_API_KEY=your-youtube-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/youtube/callback
FRONTEND_BASE_URL=http://localhost:3000

# Gemini server-side configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-enabled-gemini-model
GEMINI_VISION_MODEL=your-enabled-vision-model
