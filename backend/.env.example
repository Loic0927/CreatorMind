# PostBridge Instagram Login OAuth (safe placeholders only)
POSTBRIDGE_INSTAGRAM_CLIENT_ID=your-instagram-client-id
POSTBRIDGE_INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
POSTBRIDGE_INSTAGRAM_REDIRECT_URI=https://your-backend.example/api/instagram/connect/callback
POSTBRIDGE_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key
POSTBRIDGE_OAUTH_STATE_SECRET=generate-a-long-random-secret

# Gemini server-side configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-enabled-gemini-model
